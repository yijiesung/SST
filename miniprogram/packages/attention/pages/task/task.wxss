page { height: 100%; background: #fff; }
.attention-page { position: relative; height: 100vh; overflow: hidden; background: #fff; }
.cross { position: absolute; left: 50%; top: 45%; transform: translate(-50%, -50%); color: #111; font-size: 84rpx; }
.pair-image { position: absolute; top: 45%; width: 42vw; height: 42vw; transform: translateY(-50%); }
.pair-image.left { left: 3vw; }
.pair-image.right { right: 3vw; }
.probe { position: absolute; top: 45%; width: 44rpx; height: 44rpx; margin: -22rpx 0 0 -22rpx; border-radius: 50%; background: #172033; box-shadow: 0 0 0 8rpx rgba(23, 32, 51, .12); }
.probe.left { left: 25%; }
.probe.right { left: 75%; }
.probe.flash { background: #ef3340; box-shadow: 0 0 0 12rpx rgba(239, 51, 64, .25); animation: flash .12s 2 alternate; }
.feedback { position: absolute; left: 50%; top: 45%; transform: translate(-50%, -50%); font-size: 110rpx; font-weight: 800; }
.feedback.correct { color: #1ca66c; }
.feedback.wrong { color: #ef3340; }
.message, .error { position: absolute; left: 12%; top: 50%; width: 76%; transform: translateY(-50%); text-align: center; }
.message-title { color: #172033; font-size: 42rpx; font-weight: 750; }
.message-copy { margin-top: 22rpx; color: #657286; font-size: 27rpx; line-height: 1.6; }
.error .message-copy { white-space: pre-line; word-break: break-all; }
.start-button, .back-button { width: 320rpx; height: 92rpx; margin: 36rpx auto 0; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; color: #fff; background: #2864dc; font-size: 29rpx; font-weight: 700; }
.practice-guide { position: absolute; z-index: 2; top: 34rpx; left: 8%; width: 84%; color: #657286; font-size: 24rpx; line-height: 1.55; text-align: center; }
.loading { height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #657286; }
.spinner { width: 54rpx; height: 54rpx; margin-bottom: 24rpx; border: 6rpx solid #dbe4f5; border-top-color: #2864dc; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes flash { from { opacity: .25; } to { opacity: 1; } }
