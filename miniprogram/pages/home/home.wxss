.page { padding: 36rpx 28rpx 64rpx; }
.hero { padding: 38rpx 18rpx 28rpx; }
.day-pill { display: inline-flex; padding: 10rpx 20rpx; border-radius: 999rpx; background: #dfe9ff; color: #285bc7; font-size: 24rpx; font-weight: 600; }
.eyebrow { margin-top: 30rpx; color: #66809f; font-size: 20rpx; letter-spacing: 4rpx; }
.title { margin-top: 12rpx; font-size: 52rpx; line-height: 1.25; font-weight: 750; color: #12213b; }
.intro { margin-top: 28rpx; display: flex; flex-direction: column; gap: 14rpx; color: #58677c; font-size: 29rpx; line-height: 1.65; }
.card { background: #fff; border-radius: 28rpx; padding: 34rpx 30rpx; box-shadow: 0 14rpx 42rpx rgba(35, 55, 88, .08); }
.day-selector { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 28rpx; padding: 24rpx; border-radius: 20rpx; background: #f3f6fb; }
.day-selector-label { color: #263750; font-size: 28rpx; font-weight: 700; }
.day-selector-hint { margin-top: 6rpx; color: #8a95a5; font-size: 21rpx; }
.day-selector-control { min-width: 150rpx; padding: 18rpx 22rpx; border: 2rpx solid #cfdcf4; border-radius: 16rpx; color: #285bc7; background: #fff; font-size: 26rpx; font-weight: 700; text-align: center; }
.day-selector-arrow { margin-left: 8rpx; color: #66809f; }
.card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.card-title { font-size: 34rpx; font-weight: 700; }
.participant { margin-top: 6rpx; color: #8a95a5; font-size: 23rpx; }
.status { color: #285bc7; font-size: 28rpx; font-weight: 700; }
.label { margin: 30rpx 0 12rpx; color: #657286; font-size: 26rpx; }
.input { height: 92rpx; padding: 0 24rpx; border-radius: 18rpx; background: #f1f4f9; font-size: 30rpx; }
.primary, .secondary { margin-top: 28rpx; height: 94rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; font-size: 30rpx; font-weight: 650; }
.primary { color: #fff; background: #2864dc; box-shadow: 0 12rpx 28rpx rgba(40, 100, 220, .22); }
.secondary { color: #315a9c; background: #edf3ff; }
.privacy, .footer-note { margin-top: 20rpx; color: #8a95a5; font-size: 22rpx; line-height: 1.55; }
.task { display: flex; align-items: center; min-height: 106rpx; border-top: 1rpx solid #edf0f4; }
.task:first-of-type { border-top: 0; }
.task-index { width: 52rpx; height: 52rpx; flex: 0 0 52rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #5c6a7f; background: #edf0f5; font-size: 24rpx; font-weight: 700; }
.task-index.done { color: #fff; background: #27a873; }
.task-copy { flex: 1; min-width: 0; padding: 18rpx; }
.task-name { font-size: 28rpx; font-weight: 650; }
.task-note, .task-state { margin-top: 6rpx; color: #8a95a5; font-size: 22rpx; }
.task-state { flex: 0 0 auto; }
.complete-box { margin-top: 28rpx; padding: 28rpx; border-radius: 18rpx; text-align: center; background: #e9f8f1; color: #16855a; font-weight: 650; }
.footer-note { padding: 0 18rpx; text-align: center; }
